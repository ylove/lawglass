{
  "name": "legislation-summary",
  "version": "0.0.0",
  "description": "A localhost-first legislation tool with cited plain-language answers.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.12.1",
  "bin": {
    "legislation-summary": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": "github:ylove/legislation-summary",
  "overrides": {
    "esbuild": "0.28.2"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --project tsconfig.json && tsc --project src/web/tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:live": "vitest run --project live --passWithNoTests",
    "build": "tsup && vite build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm run test:coverage"
  },
  "dependencies": {
    "commander": "15.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/eslint": "9.6.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.4",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "happy-dom": "21.0.1",
    "prettier": "3.9.10",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "undici": "8.11.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
