{
  "name": "lawglass",
  "version": "1.2.0",
  "description": "A localhost-first legislation tool with cited plain-language answers.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "npm@11.12.1",
  "bin": {
    "lawglass": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "homepage": "https://lawglass.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ylove/lawglass.git"
  },
  "overrides": {
    "esbuild": "0.28.2"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --project tsconfig.json && tsc --project src/web/tsconfig.json",
    "test": "vitest run --project node --project web",
    "test:coverage": "vitest run --project node --project web --coverage",
    "test:live": "vitest run --project live --passWithNoTests",
    "build": "tsup && vite build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "brand:assets": "tsx scripts/brand-assets.ts",
    "site:shots": "tsx scripts/site-shots.ts",
    "history:canary": "tsx scripts/history-canary.ts",
    "fixtures:fetch": "tsx scripts/fetch-fixtures.ts",
    "eval:smoke": "tsx scripts/eval-smoke.ts",
    "eval:injection": "tsx scripts/eval-injection.ts",
    "models:fetch": "tsx scripts/fetch-models.ts",
    "models:hash": "tsx scripts/hash-models.ts",
    "lockfile:check": "tsx scripts/check-lockfile.ts",
    "test:models": "LOCAL_MODELS=1 vitest run src/core/index/local/models.integration.test.ts",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm run test:coverage",
    "smoke:package": "tsx scripts/package-smoke.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@fontsource/instrument-sans": "5.3.0",
    "@fontsource/source-serif-4": "5.3.1",
    "@google/genai": "2.30.0",
    "@hono/node-server": "2.1.5",
    "@huggingface/transformers": "4.3.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@pinecone-database/pinecone": "9.0.0",
    "cheerio": "1.2.0",
    "commander": "15.0.0",
    "hono": "4.13.13",
    "ipaddr.js": "2.5.0",
    "lucide-react": "1.59.0",
    "openai": "7.39.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "saxes": "6.0.0",
    "undici": "8.12.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.3",
    "@types/eslint": "9.6.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-regexp": "3.3.1",
    "happy-dom": "21.0.4",
    "jpeg-js": "0.4.4",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "prettier": "3.9.10",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
