# Copy to .env and fill in; never commit .env.
# Pinecone key; when set, retrieval defaults to Pinecone rather than local.
PINECONE_API_KEY=
# Anthropic API key, sent only to Anthropic.
ANTHROPIC_API_KEY=
# OpenAI API key, sent only to the configured OpenAI-compatible endpoint.
OPENAI_API_KEY=
# Optional base URL for OpenAI-compatible providers.
OPENAI_BASE_URL=
# Google API key, sent only to Google.
GOOGLE_API_KEY=

# LLM provider: anthropic, openai, google, opt-in claude-cli, or mock for CI.
LEGSUM_LLM_PROVIDER=
# Retrieval backend override: pinecone or local; otherwise chosen by key availability.
LEGSUM_BACKEND=
# Maximum stored document count (default 5).
LEGSUM_MAX_DOCS=
# Retrieval mode: dense, sparse, hybrid, or hybrid_rerank.
LEGSUM_RETRIEVAL_MODE=
# Provider-specific model for document answers.
LEGSUM_ANSWER_MODEL=
# Provider-specific model for metadata extraction.
LEGSUM_EXTRACT_MODEL=
# Retrieval-backend reranker model override.
LEGSUM_RERANK_MODEL=
# Local web server port (default 4317).
LEGSUM_PORT=
