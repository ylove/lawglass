# Copy to .env and fill in. Never commit .env.
# Retrieval backend: Pinecone is used when PINECONE_API_KEY is set; otherwise the built-in local backend.
PINECONE_API_KEY=

# LLM providers (set at least one, or use the opt-in claude-cli provider)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
GOOGLE_API_KEY=

# Optional overrides
APP_LLM_PROVIDER=
APP_MAX_DOCS=
APP_RETRIEVAL_MODE=
APP_ANSWER_MODEL=
APP_EXTRACT_MODEL=
APP_RERANK_MODEL=
APP_PORT=
